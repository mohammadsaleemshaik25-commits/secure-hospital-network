# Base64-encoded 256-bit (32-byte) AES secret key for AES-256-GCM
# Generate in PowerShell:
#   $bytes = [byte[]]::new(32); [System.Security.Cryptography.RandomNumberGenerator]::Fill($bytes); [Convert]::ToBase64String($bytes)
HOSPITAL_AES_KEY=your-32-byte-base64-key-here

# Comma-separated list of exact allowed frontend origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://<your-app>.vercel.app

# Server Port (optional locally; dynamically injected by Render in production)
PORT=8083

